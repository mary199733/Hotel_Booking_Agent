# Copy this file to Agent/.env and fill in your own values.
# Agent/.env is git-ignored; never commit real keys.

# Backboard (runs the AI agent)
BACKBOARD_API_KEY=

# SerpApi (Google Hotels search)
SERP_API_KEY=

# ElevenLabs (outbound phone calls)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=

# Anthropic (Claude Haiku reads prices out of call transcripts)
ANTHROPIC_API_KEY=

# Gmail account that sends the result email (use a Gmail App Password)
SMTP_USER=
SMTP_PASSWORD=

# Optional: where the result email goes (default: hackathon@techto.org)
RESULT_EMAIL=
